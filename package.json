{
  "name": "gaoxiang-quiz",
  "version": "1.0.0",
  "private": true,
  "description": "题本 Quizbook · 跨平台答题应用（Web / 桌面 / 移动 共用同一套 React 代码）",
  "packageManager": "pnpm@10.32.1",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "pnpm --filter @quiz/web dev",
    "build": "pnpm --filter @quiz/web build",
    "preview": "pnpm --filter @quiz/web preview",
    "test": "pnpm -r --filter './packages/*' test",
    "typecheck": "pnpm -r typecheck",
    "desktop:dev": "pnpm --filter @quiz/desktop dev",
    "desktop:build": "pnpm --filter @quiz/desktop build",
    "mobile:sync": "pnpm --filter @quiz/mobile sync",
    "mobile:ios": "pnpm --filter @quiz/mobile ios",
    "mobile:android": "pnpm --filter @quiz/mobile android"
  },
  "devDependencies": {
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
