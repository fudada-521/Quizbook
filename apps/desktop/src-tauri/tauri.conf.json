{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Megrez",
  "version": "1.0.0",
  "identifier": "com.megrez.quiz",
  "build": {
    "beforeDevCommand": "pnpm --filter @megrez/web build",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm --filter @megrez/web build",
    "frontendDist": "../web/dist"
  },
  "app": {
    "windows": [
      {
        "title": "天权",
        "width": 900,
        "height": 700,
        "minWidth": 640,
        "minHeight": 560,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}