# 监听地址与端口；本地调试用 127.0.0.1，手机同局域网调试改 0.0.0.0
HOST=127.0.0.1
PORT=8787

# 对外可访问的地址，用于生成设备码验证链接与 GitHub 回调地址
PUBLIC_URL=http://localhost:8787

# SQLite 文件位置（默认 apps/server/data/quizbook.db）
# DB_PATH=./data/quizbook.db

# GitHub OAuth App 凭据；不配置时可用 DEV_LOGIN=1 走本地开发登录
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# 本地开发登录（未配置 GitHub 时默认开启）
DEV_LOGIN=1

# 允许的跨域来源，逗号分隔；* 表示全部（使用 Bearer token，不依赖 Cookie）
CORS_ORIGIN=*

# Web 构建产物目录，server 会顺带托管它（默认 apps/web/dist）
# WEB_DIST=../web/dist