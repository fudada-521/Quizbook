# 监听地址与端口；本地调试用 127.0.0.1，手机同局域网调试改 0.0.0.0
HOST=127.0.0.1
PORT=8787

# 对外可访问的地址（仅用于展示/诊断）
PUBLIC_URL=http://localhost:8787

# SQLite 文件位置（默认 apps/server/data/megrez.db）
# DB_PATH=./data/megrez.db

# 允许的跨域来源，逗号分隔；* 表示全部（使用 Bearer token，不依赖 Cookie）
CORS_ORIGIN=*

# Web 构建产物目录，server 会顺带托管它（默认 apps/web/dist）
# WEB_DIST=../web/dist

# 管理后台产物目录，挂到 /admin/（默认 apps/admin/dist；未构建时 /admin 返回 404）
# ADMIN_DIST=../admin/dist

# 内置题库文件路径（默认自动找仓库根的 data/questions.json）
# QUESTIONS_PATH=../../data/questions.json

# 登录 token 有效期（天）
# TOKEN_TTL_DAYS=365